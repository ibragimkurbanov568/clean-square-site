# CleanLink — сводный справочник переменных окружения всего монорепозитория.
#
# Этот файл в корне НЕ читается напрямую ни Vite, ни Wrangler — он служит единой точкой
# документации для всех переменных проекта (так удобнее онбордить нового разработчика/агента).
# Реальные значения раскладываются по двум местам:
#   - frontend/.env.local      (переменные VITE_*, см. frontend/.env.example)
#   - backend/.dev.vars        (секреты Workers для `wrangler dev`, см. backend/.dev.vars.example)
# В проде секреты backend задаются через `wrangler secret put <ИМЯ>`, переменные без секретов —
# через [vars] в backend/wrangler.toml.

# =====================================================================================
# FRONTEND (Vite) — см. frontend/.env.example
# =====================================================================================

# Базовый URL API. По умолчанию "/api" (проксируется на локальный backend в dev-режиме).
VITE_API_BASE_URL=/api

# =====================================================================================
# BACKEND (Cloudflare Workers) — см. backend/.dev.vars.example, backend/wrangler.toml
# =====================================================================================

# --- JWT access + refresh в HttpOnly cookies (F1) ---
# Секреты подписи токенов. Обязательны, минимум 32 случайных символа каждый.
JWT_ACCESS_SECRET=change-me-access-token-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-token-secret-min-32-chars

# --- Шифрование чувствительных полей at rest, AES-256-GCM (допущение 9) ---
# ИНН/ОГРН компании и текст сообщений чата. Ровно 32 байта в base64 (openssl rand -base64 32).
ENCRYPTION_KEY=change-me-32-bytes-base64-encoded-key=

# --- Email через Resend API (допущение 3, 8: восстановление пароля, уведомление о заказе) ---
# Не обязателен: при пустом значении включается demo-fallback (ссылка/письмо в ответе API и логах).
RESEND_API_KEY=

# --- Служебный админ-эндпоинт ручной верификации компаний (допущение 1) ---
ADMIN_SECRET=change-me-admin-secret

# --- Rate limiting через KV-счётчики (допущение 10) ---
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# --- CORS ---
# Разрешённый origin фронтенда (в dev — Vite dev-сервер).
CORS_ORIGIN=http://localhost:5173

# --- Workers AI (допущение 6) ---
# Форсирует rule-based fallback для модерации/генерации описаний даже при наличии биндинга AI —
# полезно для детерминированных тестов и окружений без доступа к Workers AI.
AI_FORCE_FALLBACK=false
