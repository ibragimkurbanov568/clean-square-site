{
  "$schema": "CleanLink design tokens — источник истины для tailwind.config и globals.css",
  "meta": {
    "product": "CleanLink",
    "themes": ["dark", "gradient", "classic"],
    "themeLabels": {
      "dark": "Тёмная",
      "gradient": "Светлая (градиент)",
      "classic": "Классика"
    },
    "defaultTheme": "classic",
    "storageKey": "cleanlink-theme",
    "domAttribute": "data-theme",
    "notes": "Значения ниже — точные HEX/rgba для CSS custom properties в design-tokens.css. Контраст текст/фон проверен вручную по формуле WCAG relative luminance, минимум 4.5:1 для обычного текста и 3:1 для крупного текста/границ интерактивных элементов. См. docs/03-design-system.md раздел 3 для таблицы проверенных пар."
  },
  "spacing": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "24px",
    "6": "32px",
    "7": "48px",
    "8": "64px"
  },
  "radii": {
    "sm": "6px",
    "md": "10px",
    "lg": "16px",
    "xl": "20px",
    "full": "999px"
  },
  "typography": {
    "fontFamily": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
    "fontFamilyCdn": "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap",
    "sizes": {
      "xs": "12px",
      "sm": "14px",
      "base": "16px",
      "lg": "20px",
      "xl": "24px",
      "2xl": "32px"
    },
    "lineHeights": {
      "tight": 1.2,
      "normal": 1.5,
      "relaxed": 1.6
    },
    "weights": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    }
  },
  "motion": {
    "durationFast": "150ms",
    "durationBase": "200ms",
    "durationSlow": "250ms",
    "easingStandard": "cubic-bezier(0.4, 0, 0.2, 1)",
    "scaleHover": 1.05,
    "scaleActive": 0.95,
    "pageTransition": {
      "type": "fade+slide",
      "offset": "8px",
      "duration": "200ms"
    },
    "scrollReveal": {
      "mechanism": "IntersectionObserver",
      "threshold": 0.15,
      "translateY": "16px",
      "duration": "250ms",
      "stagger": "40ms"
    },
    "reducedMotion": "opacity-only, without transform, near-instant (≤50ms) — respects prefers-reduced-motion"
  },
  "themes": {
    "dark": {
      "color-bg": "#0a0a0f",
      "color-surface": "#1a1a2e",
      "color-surface-elevated": "#22223d",
      "color-surface-hover": "#202038",
      "color-border": "#2a2a45",
      "color-border-strong": "#3a3a5c",
      "color-text-primary": "#f5f4fb",
      "color-text-secondary": "#a8a7c2",
      "color-text-disabled": "#6f6e8a",
      "color-accent": "#6c63ff",
      "color-accent-600": "#5951e8",
      "color-accent-700": "#4a41d6",
      "color-accent-800": "#3830a3",
      "color-accent-subtle": "rgba(108, 99, 255, 0.16)",
      "color-accent-contrast": "#ffffff",
      "color-success": "#34d399",
      "color-success-bg": "rgba(52, 211, 153, 0.14)",
      "color-warning": "#fbbf24",
      "color-warning-bg": "rgba(251, 191, 36, 0.14)",
      "color-error": "#f87171",
      "color-error-bg": "rgba(248, 113, 113, 0.14)",
      "color-info": "#60a5fa",
      "color-info-bg": "rgba(96, 165, 250, 0.14)",
      "color-neutral": "#a8a7c2",
      "color-neutral-bg": "rgba(168, 167, 194, 0.12)",
      "color-overlay": "rgba(5, 5, 10, 0.72)",
      "color-focus-ring": "#8078ff",
      "color-star-filled": "#fbbf24",
      "color-star-empty": "#3a3a5c",
      "gradient-hero": "linear-gradient(135deg, #1a1a2e 0%, #0a0a0f 100%)",
      "shadow-sm": "0 1px 2px rgba(0, 0, 0, 0.5)",
      "shadow-md": "0 6px 16px rgba(0, 0, 0, 0.55)",
      "shadow-lg": "0 16px 40px rgba(0, 0, 0, 0.6)"
    },
    "gradient": {
      "color-bg": "#f5f0ff",
      "color-surface": "#ffffff",
      "color-surface-elevated": "#fefcff",
      "color-surface-hover": "#f7f2ff",
      "color-border": "#e4defa",
      "color-border-strong": "#cdbdf0",
      "color-text-primary": "#241f38",
      "color-text-secondary": "#6b6485",
      "color-text-disabled": "#a79fc2",
      "color-accent": "#7c3aed",
      "color-accent-600": "#6d28d9",
      "color-accent-700": "#5b21b6",
      "color-accent-800": "#4c1d95",
      "color-accent-subtle": "rgba(124, 58, 237, 0.10)",
      "color-accent-contrast": "#ffffff",
      "color-success": "#15803d",
      "color-success-bg": "#dcfce7",
      "color-warning": "#b45309",
      "color-warning-bg": "#fef3c7",
      "color-error": "#b91c1c",
      "color-error-bg": "#fee2e2",
      "color-info": "#1d4ed8",
      "color-info-bg": "#dbeafe",
      "color-neutral": "#6b6485",
      "color-neutral-bg": "#ece7f7",
      "color-overlay": "rgba(36, 31, 56, 0.45)",
      "color-focus-ring": "#7c3aed",
      "color-star-filled": "#f5a623",
      "color-star-empty": "#e4defa",
      "gradient-hero": "linear-gradient(135deg, #a18cd1 0%, #fbc2eb 100%)",
      "shadow-sm": "0 1px 2px rgba(36, 31, 56, 0.06)",
      "shadow-md": "0 4px 12px rgba(36, 31, 56, 0.08)",
      "shadow-lg": "0 12px 32px rgba(36, 31, 56, 0.14)"
    },
    "classic": {
      "color-bg": "#ffffff",
      "color-surface": "#f8fafc",
      "color-surface-elevated": "#ffffff",
      "color-surface-hover": "#f1f5f9",
      "color-border": "#e2e8f0",
      "color-border-strong": "#cbd5e1",
      "color-text-primary": "#0f172a",
      "color-text-secondary": "#475569",
      "color-text-disabled": "#94a3b8",
      "color-accent": "#1e3a8a",
      "color-accent-600": "#2b4aa8",
      "color-accent-700": "#1e3a8a",
      "color-accent-800": "#16295c",
      "color-accent-subtle": "rgba(30, 58, 138, 0.08)",
      "color-accent-contrast": "#ffffff",
      "color-success": "#15803d",
      "color-success-bg": "#dcfce7",
      "color-warning": "#b45309",
      "color-warning-bg": "#fef3c7",
      "color-error": "#b91c1c",
      "color-error-bg": "#fee2e2",
      "color-info": "#1d4ed8",
      "color-info-bg": "#dbeafe",
      "color-neutral": "#475569",
      "color-neutral-bg": "#e2e8f0",
      "color-overlay": "rgba(15, 23, 42, 0.5)",
      "color-focus-ring": "#1e3a8a",
      "color-star-filled": "#d97706",
      "color-star-empty": "#cbd5e1",
      "gradient-hero": "linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%)",
      "shadow-sm": "0 1px 2px rgba(15, 23, 42, 0.06)",
      "shadow-md": "0 4px 12px rgba(15, 23, 42, 0.08)",
      "shadow-lg": "0 12px 32px rgba(15, 23, 42, 0.12)"
    }
  },
  "orderStatus": {
    "created": { "token": "info", "labelRu": "Создан" },
    "in_progress": { "token": "warning", "labelRu": "В работе" },
    "done": { "token": "success", "labelRu": "Выполнен" },
    "cancelled": { "token": "neutral", "labelRu": "Отменён" }
  }
}
